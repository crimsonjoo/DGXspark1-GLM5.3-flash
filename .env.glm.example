# Persistent settings loaded by start.sh/apply.sh. Shell syntax; do not add spaces around '='.
PORT=18080
HOST=0.0.0.0
MODEL_NAME=GLM-5.3-Flash-EXL3-2.05
MODEL_DIR=$HOME/models/GLM-5.3-Flash-exl3-2.05bpw
DFLASH_DIR=$HOME/models/GLM-5.3-Flash-DFlash2
CACHE_ROOT=$HOME/.cache/glm53-one-spark
IMAGE=glm53-one-spark:local
BUILD_IMAGE=1
FORCE_BUILD=0

# DFlash2 is CC BY-NC-ND 4.0 (non-commercial research/evaluation).
# Read its license before changing this to 1. Interactive start.sh can ask once.
ACCEPT_DFLASH2_NC_LICENSE=0

CTX=262144
SEQS=4
GPU_MEM=0.90
MAX_BATCHED_TOKENS=7168
K=5
SSH_USER=sejin
CONFIGURE_SSH=1
RESET_SSH_PASSWORD=0
WATCHDOG=1
WATCHDOG_INTERVAL=30
WATCHDOG_FAILURES=6
WATCHDOG_STARTUP_GRACE=1200
WATCHDOG_DEEP_CHECK=1
WATCHDOG_DEEP_INTERVAL=600
WATCHDOG_DEEP_TIMEOUT=120
WATCHDOG_DEEP_FAILURES=3
WATCHDOG_MAX_RESTARTS=3
WATCHDOG_RESTART_WINDOW=3600
READY_TIMEOUT=1200
